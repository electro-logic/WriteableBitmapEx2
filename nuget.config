<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds the local private feed used to publish the package.
    nuget.org is still inherited from the machine-level configuration (no <clear/>),
    so test/benchmark dependencies continue to restore normally.
  -->
  <packageSources>
    <add key="PrivateNuget" value="D:\Projects\PrivateNuget" />
  </packageSources>
</configuration>
