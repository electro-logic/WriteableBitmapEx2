root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets}]
indent_style = tab

[*.{md,json,yml,yaml,xml,config}]
indent_style = space
indent_size = 2
